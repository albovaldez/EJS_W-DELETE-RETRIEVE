<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>List of students</title>
    <style>

    body {
         background-color: #93c2ee;
        }

    table {
        border-collapse: collapse;
        width: 70%;
        margin: 0 auto;
        margin-top: 5%;
        background-color: #f0f2f5;
    }

    table, th, td {
        border: 1px solid black;
    }

    th, td {
        padding: 10px;
        text-align: left;
    }

</style>
</head>
<body>
    <table>
        <thead>
            <tr>
                <th>student ID</th>
                <th>Firstname</th>
                <th>lastname</th>
                <th>address</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <%
                if(student.length > 0){
                    student.forEach((data)=>{

        
            %>
            <tr>
                <td><%=  data.student_id  %></td>
                <td><%=  data.firstname  %></td>
                <td><%=  data.lastname  %></td>
                <td><%=  data.address  %></td>
                <td> <a href="/delete/<%= data.student_id %>" onclick="return confirm('Do you want to delete this account?')"> Delete </a> </td>
            </tr>
            <%
                     })
                }
            %>
        </tbody>
    </table>
    
</body>
</html>